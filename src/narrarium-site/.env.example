# Optional Google OAuth client ID override.
# The production public client ID is already built into the app.
# Create at https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized JavaScript origins: https://narrarium.net, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=91477716497-k7n97b2q9ic3nc75jpjmb0d3f73s1vgu.apps.googleusercontent.com

# Optional Microsoft Entra ID app registration client ID override.
# The production public client ID is already built into the app.
# Redirect URI: https://narrarium.net/ and http://localhost:5173/
VITE_MICROSOFT_CLIENT_ID=a80b2024-b9e3-4cb1-8480-aac7f164a6eb

# GitHub OAuth Web Flow + PKCE preparation. The client secret value must be
# Base64-encoded three times. This is obfuscation only, not encryption.
# GitHub currently omits the CORS response header required by a static browser,
# so production keeps OAuth disabled and offers PAT until that changes.
VITE_GITHUB_OAUTH_CLIENT_ID=
VITE_GITHUB_OAUTH_CLIENT_SECRET_B64X3=

# Override the base path for GitHub Pages project deployments.
# Use / for narrarium.net custom domain deployments.
# SITE_BASE=/GhostWriterFramework/
