{
  "name": "narrarium-engine",
  "version": "0.1.8",
  "type": "module",
  "description": "Shared Narrarium engine: autopilot, director, simulated readers, and personal-server sync. The same code runs in the browser app and in the npx server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeyserDSoze/GhostWriterFramework",
    "directory": "packages/engine"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "narrarium",
    "autopilot",
    "director",
    "books",
    "writing"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "validate": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "narrarium": "^0.1.60",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
