---
import "../styles/global.css";
import ReaderRuntime from "../components/ReaderRuntime.astro";
import SiteSearch from "../components/SiteSearch.astro";
import { listChapters } from "narrarium";
import { getBookRoot } from "../lib/book.js";
import { loadCanonGlossary } from "../lib/glossary.js";
import { isFullCanonMode } from "../lib/reader-mode.js";
import { publishesCanonPages } from "../lib/reader-build.js";
import { loadSearchIndex } from "../lib/search.js";

interface Props {
  title: string;
  description?: string;
  activeSection?:
    | "home"
    | "chapters"
    | "workshop"
    | "characters"
    | "locations"
    | "factions"
    | "items"
    | "secrets"
    | "timeline";
  currentChapterNumber?: number;
}

const { title, description, activeSection = "home", currentChapterNumber } = Astro.props;
// A protected book publishes the reader alone (its text is in the encrypted bundle): these pages are written empty, then left out of the
// published files, so that no title, name or line of the book is in clear.
const published = publishesCanonPages();
const canonGlossary = published ? await loadCanonGlossary(currentChapterNumber) : [];
const searchIndex = published ? await loadSearchIndex(currentChapterNumber) : [];
const readerChapters = published ? await listChapters(getBookRoot()).catch(() => []) : [];
const fullCanonMode = isFullCanonMode();
const isChapterPage = Number.isFinite(currentChapterNumber);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{published ? title : "Narrarium Reader"}</title>
    {published && description && <meta name="description" content={description} />}
    {!published && <meta name="robots" content="noindex, nofollow" />}
    <base href={import.meta.env.BASE_URL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const themeStorageKey = "narrarium-reader-theme";
        const root = document.documentElement;
        const prefersDark =
          typeof window.matchMedia === "function" && window.matchMedia("(prefers-color-scheme: dark)").matches;

        try {
          const saved = localStorage.getItem(themeStorageKey);
          root.dataset.theme = saved || (prefersDark ? "dark" : "light");
        } catch {
          root.dataset.theme = prefersDark ? "dark" : "light";
        }
      })();
    </script>
  </head>
    <body class:list={[isChapterPage && "page-chapter"]} data-reader-chapter-number={published ? currentChapterNumber : undefined} data-full-canon={fullCanonMode ? "true" : "false"}>
    <script is:inline>
      // The pages of the canon are never encrypted: a protected book publishes only the reader (see publishesCanonPages).
      window._narrariumContentReady = Promise.resolve("plain");
    </script>
    {!published ? (
      <main class="shell">
        <p class="lede">This book is protected. <a href="./">Open the reader</a>.</p>
      </main>
    ) : (
    <main class="shell">
      <header class="masthead">
        <a class="brand" href="book/">Narrarium</a>
        <nav class="site-nav">
          <a class="nav-link" href="./">Read</a>
          <a class:list={["nav-link", activeSection === "home" && "is-active"]} href="book/">Book</a>
          <a class:list={["nav-link", activeSection === "chapters" && "is-active"]} href="book/#chapters">Chapters</a>
          {fullCanonMode && <a class:list={["nav-link", activeSection === "workshop" && "is-active"]} href="workshop/">Workshop</a>}
          <a class:list={["nav-link", activeSection === "characters" && "is-active"]} href="characters/">Characters</a>
          <a class:list={["nav-link", activeSection === "locations" && "is-active"]} href="locations/">Locations</a>
          <a class:list={["nav-link", activeSection === "factions" && "is-active"]} href="factions/">Factions</a>
          <a class:list={["nav-link", activeSection === "items" && "is-active"]} href="items/">Items</a>
          {fullCanonMode && <a class:list={["nav-link", activeSection === "secrets" && "is-active"]} href="secrets/">Secrets</a>}
          <a class:list={["nav-link", activeSection === "timeline" && "is-active"]} href="timeline/">Timeline</a>
        </nav>
        <div class="masthead-actions">
          <a class="chip reader-status" data-continue-link href="./" hidden>Continue reading</a>
          <button type="button" class="masthead-btn" data-tts-panel-toggle aria-label="Open read aloud controls" aria-pressed="false" hidden>🔊</button>
          <button type="button" class="masthead-btn" data-epub-download aria-label="Download EPUB" hidden>⬇</button>
          <button type="button" class="masthead-btn" data-search-toggle aria-label="Search">🔍</button>
          <button type="button" class="masthead-btn" data-reader-settings-toggle aria-label="Open reading settings">⚙</button>
        </div>
      </header>
      <slot />
    </main>
    )}
    {published && <SiteSearch entries={searchIndex} />}
    {published && <ReaderRuntime glossary={canonGlossary} chapters={readerChapters} currentChapterNumber={currentChapterNumber} />}
    <script is:inline>
      /* ── EPUB download ──────────────────────────────────────────────────────
         The epub.enc static endpoint holds the EPUB of a public book; the
         client fetches it, wraps it in a Blob and triggers a download.
      ──────────────────────────────────────────────────────────────────────── */
      (function () {
        var btn = document.querySelector("[data-epub-download]");
        if (!btn) return;

        window._narrariumContentReady.then(function (state) {
          if (state === "decrypted" || state === "plain") {
            btn.removeAttribute("hidden");
          }
        });

        btn.addEventListener("click", function () {
          var epubUrl = new URL("epub.enc", document.baseURI).toString();

          btn.setAttribute("disabled", "");

          fetch(epubUrl)
            .then(function (r) {
              if (!r.ok) throw new Error("fetch failed: " + r.status);
              return r.arrayBuffer();
            })
            .then(function (plainBuf) {
              var blob = new Blob([plainBuf], { type: "application/epub+zip" });
              var url = URL.createObjectURL(blob);
              var a = document.createElement("a");
              a.href = url;
              a.download = "book.epub";
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
            })
            .catch(function (err) {
              console.error("[narrarium] EPUB download failed", err);
            })
            .finally(function () {
              btn.removeAttribute("disabled");
            });
        });
      })();
    </script>
  </body>
</html>
