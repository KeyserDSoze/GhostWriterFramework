---
import "../styles/reader.css";
import { getBookRoot } from "../lib/book.js";
import { getReaderBuild } from "../lib/reader-build.js";
import { readerLabels, readerLanguage } from "../lib/reader-i18n.js";

/**
 * The shell of the published reader: its code, its words and the version it belongs to, never a word of the book. On every open it asks
 * `version.json` (no-store), reloads once if it is not the current build, unlocks a protected book and downloads the bundle by its hashed
 * name (see lib/reader-session.ts).
 */
const build = await getReaderBuild(getBookRoot());
const labels = readerLabels(build.language);
const uiLanguage = readerLanguage(build.language);
const boot = {
  version: build.version,
  bookId: build.bookId,
  fallback: build.versionFile,
  labels,
  bookLanguage: build.language,
  canonHref: build.protected ? null : "book/",
};
const bootJson = JSON.stringify(boot).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={uiLanguage} data-reader-version={build.version}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{build.title}</title>
    {build.protected && <meta name="robots" content="noindex, nofollow" />}
    <base href={import.meta.env.BASE_URL} />
  </head>
  <body class="reader-body">
    <a class="reader-skip" href="#reader-text">{labels.skipToText}</a>
    <p class="reader-status" id="reader-status" role="status" aria-live="polite">{labels.loading}</p>

    <section class="reader-lock" id="reader-lock" aria-labelledby="reader-lock-title" hidden>
      <div class="reader-lock__panel">
        <p class="reader-lock__book">{build.title}</p>
        <h1 class="reader-lock__title" id="reader-lock-title">{labels.lockTitle}</h1>
        <p class="reader-lock__intro" id="reader-lock-intro">{labels.lockIntro}</p>
        <p class="reader-lock__message" id="reader-lock-message" role="alert" hidden></p>
        <form class="reader-lock__form" id="reader-lock-form" novalidate>
          <label class="reader-lock__label" for="reader-password">{labels.passwordLabel}</label>
          <div class="reader-lock__field">
            <input
              id="reader-password"
              name="password"
              type="password"
              autocomplete="current-password"
              autocapitalize="off"
              spellcheck="false"
              required
              aria-describedby="reader-lock-intro reader-lock-message"
            />
            <button type="button" class="reader-lock__reveal" id="reader-password-reveal" aria-pressed="false" aria-controls="reader-password">{labels.showPassword}</button>
          </div>
          <label class="reader-lock__remember">
            <input type="checkbox" id="reader-remember" checked />
            <span>{labels.rememberLabel}</span>
          </label>
          <button type="submit" class="reader-lock__submit" id="reader-unlock">{labels.unlock}</button>
        </form>
      </div>
    </section>

    <div class="reader-app" id="reader-app" hidden>
      <header class="reader-bar">
        <p class="reader-bar__title">{build.title}</p>
        <label class="reader-bar__contents">
          <span class="reader-visually-hidden">{labels.contents}</span>
          <select id="reader-chapter-select"></select>
        </label>
      </header>
      <main class="reader-text" id="reader-text" tabindex="-1" lang={build.language}></main>
      <nav class="reader-pager" aria-label={labels.contents}>
        <button type="button" id="reader-previous">{labels.previousChapter}</button>
        <span id="reader-position"></span>
        <button type="button" id="reader-next">{labels.nextChapter}</button>
      </nav>
      {build.protected && (
        <p class="reader-forget">
          <button type="button" id="reader-forget">{labels.forgetPassword}</button>
        </p>
      )}
    </div>

    <script type="application/json" id="narrarium-reader-boot" set:html={bootJson}></script>
    <script>
      import { startReaderShell } from "../lib/reader-shell";
      void startReaderShell();
    </script>
  </body>
</html>
