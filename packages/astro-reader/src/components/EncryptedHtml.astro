---
interface Props {
  /** Safe HTML rendered as it is. The pages of the canon are not encrypted any more: a protected book publishes only the reader, whose
   * bundle is encrypted as a whole (see `lib/reader-build.ts`). The component keeps its name for the pages that use it. */
  html: string;
}

const { html } = Astro.props;
---

<Fragment set:html={html} />
