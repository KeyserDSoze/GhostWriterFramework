{
  "name": "narrarium-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Personal Narrarium server: runs the autopilot and the director for your books even with the browser closed, and syncs them with the web app. Start it with `npx narrarium-server`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeyserDSoze/GhostWriterFramework",
    "directory": "packages/server"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "narrarium-server": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "narrarium",
    "autopilot",
    "server",
    "books",
    "writing"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "validate": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "narrarium-engine": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
