{
  "name": "narrarium-server",
  "version": "0.1.9",
  "type": "module",
  "description": "Personal Narrarium server: runs the autopilot and the director for your books even with the browser closed, syncs them with the web app, and updates itself from npm. Start it with `npx narrarium-server`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeyserDSoze/GhostWriterFramework",
    "directory": "packages/server"
  },
  "bin": {
    "narrarium-server": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/cli.mjs.map",
    "dist/server.mjs",
    "dist/server.mjs.map",
    "README.md"
  ],
  "keywords": [
    "narrarium",
    "autopilot",
    "server",
    "books",
    "writing",
    "cloudflare"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "start": "node dist/cli.mjs start --direct",
    "test": "npm run build && node --test --test-timeout=300000 test/*.test.mjs",
    "validate": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "esbuild": "^0.28.2",
    "narrarium-engine": "^0.1.0",
    "typescript": "^5.9.3"
  }
}
